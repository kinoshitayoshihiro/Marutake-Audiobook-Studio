# Optional. DummyProvider is the default and needs no secret.
OPENAI_API_KEY=
MARUTAKE_X_OPENAI_MODEL=gpt-5.2

# Optional. Required only when running publish-x or publish-x-thread with --live.
# Use OAuth 2.0 Authorization Code Flow with PKCE to obtain these values.
MARUTAKE_X_CLIENT_ID=
MARUTAKE_X_CALLBACK_URL=
MARUTAKE_X_USER_ACCESS_TOKEN=
MARUTAKE_X_REFRESH_TOKEN=
