# Keep Google Drive/local data out of GitHub by default.
*

# Git repository metadata files.
!.gitignore

# Python and shell tools.
!2tb/
2tb/*
!2tb/*.py
!2tb/*.php
!2tb/tools/
2tb/tools/*
!2tb/tools/*.py

# YouTube report runners and their dependency manifest.
!2tb/youtube_channel_report/
2tb/youtube_channel_report/*
!2tb/youtube_channel_report/*.py
!2tb/youtube_channel_report/*.sh
!2tb/youtube_channel_report/requirements.txt

# Channel report app and shared packages.
!apps/
apps/*
!apps/audiobookstudio/
apps/audiobookstudio/*
!apps/audiobookstudio/channel-report/
!apps/audiobookstudio/channel-report/*.html
!apps/audiobookstudio/channel-report/*.css
!apps/audiobookstudio/channel-report/*.js
!apps/audiobookstudio/channel-report/*.md

!packages/
packages/*
!packages/channel-report-engine/
!packages/channel-report-engine/*.js
!packages/youtube-analytics/
!packages/youtube-analytics/*.js
!packages/shared-types/
!packages/shared-types/*.md

!docs/
!docs/*.md

!data/
data/*
!data/youtube/
data/youtube/*
!data/youtube/reports/
!data/youtube/inventory/
!data/youtube/by-author/
!data/youtube/exports/

# Local execution artifacts and secrets must stay local.
**/__pycache__/
**/.venv/
**/*.pyc
**/.DS_Store
**/client_secret.json
**/token.json
